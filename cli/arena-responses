#!/usr/bin/env node
// arena-responses —— 把 OpenAI Responses API 转成 arena_bridge 的 chat/completions
// 监听 127.0.0.1:17893，供 Codex CLI 之类的 Responses 客户端使用
'use strict';
const http = require('http');

const PORT = Number(process.env.ARB_RESP_PORT || 17893);
const UP = process.env.ARB_UPSTREAM || 'http://127.0.0.1:17892';
const DEFAULT_MODEL = process.env.ARB_MODEL || 'arena-agent';

const log = (...a) => console.error(new Date().toISOString(), ...a);

function json(res, code, obj) {
  const b = JSON.stringify(obj);
  res.writeHead(code, { 'content-type': 'application/json', 'content-length': Buffer.byteLength(b) });
  res.end(b);
}

function readBody(req) {
  return new Promise((resolve, reject) => {
    let d = '';
    req.on('data', c => { d += c; if (d.length > 4e6) reject(new Error('body too large')); });
    req.on('end', () => resolve(d));
    req.on('error', reject);
  });
}

// 把 responses 的 input 拍平成 chat 的 messages
function toMessages(body) {
  const msgs = [];
  if (body.instructions) msgs.push({ role: 'system', content: String(body.instructions) });
  const inp = body.input;
  const pushItem = it => {
    if (it == null) return;
    if (typeof it === 'string') { msgs.push({ role: 'user', content: it }); return; }
    const role = it.role === 'assistant' ? 'assistant' : (it.role === 'system' ? 'system' : 'user');
    let text = '';
    if (typeof it.content === 'string') text = it.content;
    else if (Array.isArray(it.content)) {
      text = it.content.map(p => {
        if (typeof p === 'string') return p;
        if (p && typeof p.text === 'string') return p.text;
        if (p && p.type === 'input_image') return '[图片已省略]';
        return '';
      }).join('');
    }
    if (!text && it.type === 'function_call_output') text = String(it.output || '');
    if (!text) return;
    msgs.push({ role, content: text });
  };
  if (typeof inp === 'string') pushItem(inp);
  else if (Array.isArray(inp)) inp.forEach(pushItem);
  else if (inp && typeof inp === 'object') pushItem(inp);
  return msgs.filter(m => m.content);
}

function newId(p) { return p + '_' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8); }

function itemObj(id, text, status) {
  return { id, type: 'message', role: 'assistant', status, content: text === null ? [] : [{ type: 'output_text', text, annotations: [] }] };
}

async function upstreamChat(messages, model, onDelta) {
  const payload = JSON.stringify({ model, messages, stream: true, user: 'codex' });
  const r = await fetch(UP + '/v1/chat/completions', {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: payload
  });
  if (!r.ok) {
    const t = await r.text();
    throw new Error('upstream ' + r.status + ': ' + t.slice(0, 300));
  }
  const reader = r.body.getReader();
  const dec = new TextDecoder();
  let buf = '', text = '';
  while (true) {
    const { value, done } = await reader.read();
    if (done) break;
    buf += dec.decode(value, { stream: true });
    let idx;
    while ((idx = buf.indexOf('\n\n')) >= 0) {
      const block = buf.slice(0, idx); buf = buf.slice(idx + 2);
      for (const line of block.split('\n')) {
        if (!line.startsWith('data:')) continue;
        const data = line.slice(5).trim();
        if (!data || data === '[DONE]') continue;
        let o; try { o = JSON.parse(data); } catch { continue; }
        if (o.error) throw new Error(String(o.error.message || o.error));
        const d = o.choices && o.choices[0] && o.choices[0].delta;
        if (d && typeof d.content === 'string' && d.content) { text += d.content; onDelta(d.content); }
      }
    }
  }
  return text;
}

const server = http.createServer(async (req, res) => {
  const u = new URL(req.url, 'http://x');
  if (u.pathname === '/health') return json(res, 200, { ok: true, up: UP });
  if (u.pathname === '/v1/models') {
    return json(res, 200, { object: 'list', data: [
      { id: 'arena-agent', object: 'model', owned_by: 'arena' },
      { id: 'arena-direct', object: 'model', owned_by: 'arena' }
    ] });
  }
  if ((u.pathname === '/v1/responses' || u.pathname === '/responses') && req.method === 'POST') {
    let body;
    try { body = JSON.parse(await readBody(req) || '{}'); }
    catch (e) { return json(res, 400, { error: { message: 'bad json', type: 'invalid_request_error' } }); }

    const messages = toMessages(body);
    const model = (body.model && !/^arena-/.test(body.model)) ? body.model : DEFAULT_MODEL;
    if (!messages.length) return json(res, 400, { error: { message: 'no input', type: 'invalid_request_error' } });

    const rid = newId('resp');
    const mid = newId('msg');
    log('resp', body.model || '-', 'msgs=' + messages.length, 'stream=' + !!body.stream);

    if (!body.stream) {
      try {
        const text = await upstreamChat(messages, model, () => {});
        return json(res, 200, {
          id: rid, object: 'response', created_at: Math.floor(Date.now() / 1000), status: 'completed',
          model, output: [itemObj(mid, text, 'completed')], parallel_tool_calls: false, tool_choice: 'auto', tools: []
        });
      } catch (e) { return json(res, 502, { error: { message: e.message, type: 'upstream_error' } }); }
    }

    res.writeHead(200, { 'content-type': 'text/event-stream', 'cache-control': 'no-cache', connection: 'keep-alive' });
    const send = (type, obj) => { res.write('event: ' + type + '\n' + 'data: ' + JSON.stringify(obj) + '\n\n'); };
    const base = { id: rid, object: 'response', created_at: Math.floor(Date.now() / 1000), model, parallel_tool_calls: false, tool_choice: 'auto', tools: [] };

    send('response.created', { type: 'response.created', response: Object.assign({}, base, { status: 'in_progress', output: [] }) });
    send('response.output_item.added', { type: 'response.output_item.added', output_index: 0, item: itemObj(mid, null, 'in_progress') });
    send('response.content_part.added', { type: 'response.content_part.added', item_id: mid, output_index: 0, content_index: 0, part: { type: 'output_text', text: '', annotations: [] } });

    const ping = setInterval(() => { try { res.write(': ping\n\n'); } catch (e) {} }, 15000);
    let text = '';
    try {
      text = await upstreamChat(messages, model, d => {
        send('response.output_text.delta', { type: 'response.output_text.delta', item_id: mid, output_index: 0, content_index: 0, delta: d });
      });
    } catch (e) {
      clearInterval(ping);
      log('error', e.message);
      send('response.failed', { type: 'response.failed', response: Object.assign({}, base, { status: 'failed', error: { code: 'upstream_error', message: e.message } }) });
      return res.end();
    }
    clearInterval(ping);

    if (!text.trim()) {
      send('response.failed', { type: 'response.failed', response: Object.assign({}, base, { status: 'failed', error: { code: 'empty', message: 'empty answer from upstream' } }) });
      return res.end();
    }
    const item = itemObj(mid, text, 'completed');
    send('response.output_text.done', { type: 'response.output_text.done', item_id: mid, output_index: 0, content_index: 0, text });
    send('response.content_part.done', { type: 'response.content_part.done', item_id: mid, output_index: 0, content_index: 0, part: { type: 'output_text', text, annotations: [] } });
    send('response.output_item.done', { type: 'response.output_item.done', output_index: 0, item });
    send('response.completed', {
      type: 'response.completed',
      response: Object.assign({}, base, {
        status: 'completed', end_turn: true, output: [item],
        usage: { input_tokens: 0, output_tokens: 0, total_tokens: 0, input_tokens_details: { cached_tokens: 0 }, output_tokens_details: { reasoning_tokens: 0 } }
      })
    });
    res.end();
    return;
  }
  json(res, 404, { error: { message: 'not found', path: u.pathname } });
});

server.listen(PORT, '127.0.0.1', () => log('listening on 127.0.0.1:' + PORT + ' → ' + UP));

